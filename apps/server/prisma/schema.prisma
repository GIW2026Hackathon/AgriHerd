generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FARMER
  FARM_WORKER
  PROFESSIONAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum FarmMembershipRole {
  OWNER
  MANAGER
  WORKER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AnimalPurpose {
  BEEF
  DAIRY
}

enum AnimalSex {
  FEMALE
  MALE
  UNKNOWN
}

enum AnimalStatus {
  ACTIVE
  INACTIVE
  DECEASED
  SOLD
}

model User {
  id             String           @id @default(cuid())
  fullName       String
  email          String           @unique
  passwordHash   String
  role           UserRole         @default(FARMER)
  status         UserStatus       @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  memberships    FarmMembership[]
  sessions       Session[]
  auditEntries   AuditLog[]       @relation("AuditActor")
}

model Farm {
  id              String           @id @default(cuid())
  name            String
  locationLabel   String?
  preferredUnits  String           @default("METRIC")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     FarmMembership[]
  animals         Animal[]
}

model FarmMembership {
  id        String               @id @default(cuid())
  farmId    String
  userId    String
  role      FarmMembershipRole   @default(OWNER)
  status    MembershipStatus     @default(ACTIVE)
  createdAt DateTime             @default(now())
  farm      Farm                 @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([farmId, userId])
  @@index([userId, status])
}

model Animal {
  id                  String        @id @default(cuid())
  farmId              String
  internalCode        String
  earTag              String?
  name                String
  breed               String
  sex                 AnimalSex
  purpose             AnimalPurpose
  birthDate           DateTime?     @db.Date
  estimatedAgeMonths  Int?
  status              AnimalStatus  @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  farm                Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([farmId, internalCode])
  @@unique([farmId, earTag])
  @@index([farmId, name])
  @@index([farmId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String
  entityType    String
  entityId      String
  action        String
  occurredAt    DateTime @default(now())
  changeSummary Json?
  actor         User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
}
