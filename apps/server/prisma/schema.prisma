generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FARMER
  FARM_WORKER
  PROFESSIONAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum FarmMembershipRole {
  OWNER
  MANAGER
  WORKER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AnimalPurpose {
  BEEF
  DAIRY
}

enum AnimalSex {
  FEMALE
  MALE
  UNKNOWN
}

enum AnimalStatus {
  ACTIVE
  INACTIVE
  DECEASED
  SOLD
}

enum FeedUnit {
  KG
  G
  L
  ML
  BALE
  BAG
  OTHER
}

enum GuidanceScope {
  ALL_CATTLE
  DAIRY
  BEEF
}

enum GuidanceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExtensionCategory {
  HEALTH
  NUTRITION
  HERD_MANAGEMENT
}

enum ExtensionUrgency {
  ROUTINE
  SOON
  URGENT
}

enum ExtensionStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ContactMethod {
  PHONE
  EMAIL
  IN_PERSON
}

model User {
  id             String           @id @default(cuid())
  fullName       String
  email          String           @unique
  passwordHash   String
  role           UserRole         @default(FARMER)
  status         UserStatus       @default(ACTIVE)
  mustChangePassword Boolean      @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  memberships    FarmMembership[]
  sessions       Session[]
  professionalProfile ProfessionalProfile?
  feedRecords    FeedRecord[]     @relation("FeedRecorder")
  authoredGuidance NutritionResource[] @relation("GuidanceAuthor")
  reviewedGuidance NutritionResource[] @relation("GuidanceReviewer")
  submittedRequests ExtensionRequest[] @relation("RequestSubmitter")
  assignedRequests ExtensionRequest[] @relation("RequestAssignee")
  extensionInteractions ExtensionInteraction[] @relation("InteractionProfessional")
  auditEntries   AuditLog[]       @relation("AuditActor")
}

model Farm {
  id              String           @id @default(cuid())
  name            String
  locationLabel   String?
  preferredUnits  String           @default("METRIC")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     FarmMembership[]
  animals         Animal[]
  feedRecords     FeedRecord[]
  extensionRequests ExtensionRequest[]
}

model FarmMembership {
  id        String               @id @default(cuid())
  farmId    String
  userId    String
  role      FarmMembershipRole   @default(OWNER)
  status    MembershipStatus     @default(ACTIVE)
  createdAt DateTime             @default(now())
  farm      Farm                 @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([farmId, userId])
  @@index([userId, status])
}

model Animal {
  id                  String        @id @default(cuid())
  farmId              String
  internalCode        String
  earTag              String?
  name                String
  breed               String
  sex                 AnimalSex
  purpose             AnimalPurpose
  birthDate           DateTime?     @db.Date
  estimatedAgeMonths  Int?
  status              AnimalStatus  @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  farm                Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  feedRecords         FeedRecord[]
  extensionRequests   ExtensionRequest[]

  @@unique([farmId, internalCode])
  @@unique([farmId, earTag])
  @@index([farmId, name])
  @@index([farmId, createdAt])
}

model ProfessionalProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  qualifications String
  serviceArea  String
  publicEmail  String?
  publicPhone  String?
  isListed     Boolean  @default(false)
  verifiedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isListed, verifiedAt])
}

model FeedRecord {
  id          String    @id @default(cuid())
  farmId      String
  animalId    String?
  recordedById String
  feedName    String
  quantity    Decimal   @db.Decimal(12, 3)
  unit        FeedUnit
  unitLabel   String?
  recordedAt  DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())
  farm        Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal      Animal?   @relation(fields: [animalId], references: [id], onDelete: SetNull)
  recordedBy  User      @relation("FeedRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([farmId, recordedAt])
  @@index([animalId, recordedAt])
}

model NutritionResource {
  id            String         @id @default(cuid())
  title         String
  content       String
  scope         GuidanceScope  @default(ALL_CATTLE)
  source        String?
  sourceUrl     String?
  reviewDate    DateTime?      @db.Date
  reviewedById  String?
  createdById   String
  status        GuidanceStatus @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  reviewedBy    User?          @relation("GuidanceReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdBy     User           @relation("GuidanceAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, scope, updatedAt])
}

model ExtensionRequest {
  id                     String            @id @default(cuid())
  reference              String            @unique
  farmId                 String
  submittedById          String
  animalId               String?
  assignedProfessionalId String
  category               ExtensionCategory
  description            String
  urgency                ExtensionUrgency   @default(ROUTINE)
  contactMethod          ContactMethod
  preferredContactValue  String?
  consentedAt            DateTime
  status                 ExtensionStatus    @default(OPEN)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  farm                   Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  submittedBy            User               @relation("RequestSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  animal                 Animal?            @relation(fields: [animalId], references: [id], onDelete: SetNull)
  assignedProfessional   User               @relation("RequestAssignee", fields: [assignedProfessionalId], references: [id], onDelete: Restrict)
  interactions           ExtensionInteraction[]

  @@index([farmId, createdAt])
  @@index([assignedProfessionalId, status, updatedAt])
}

model ExtensionInteraction {
  id                   String           @id @default(cuid())
  requestId            String
  professionalUserId   String
  interactionDate      DateTime         @default(now())
  advice               String
  followUpDate         DateTime?        @db.Date
  outcome              String?
  createdAt            DateTime         @default(now())
  request              ExtensionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  professional         User             @relation("InteractionProfessional", fields: [professionalUserId], references: [id], onDelete: Restrict)

  @@index([requestId, interactionDate])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String
  entityType    String
  entityId      String
  action        String
  occurredAt    DateTime @default(now())
  changeSummary Json?
  actor         User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
}
