# DairyHub local environment
# Copy this file to .env and replace values marked REPLACE_ME.
# Never commit .env or expose server-only values through VITE_* variables.

# -----------------------------
# Frontend
# -----------------------------
# Safe to expose in the browser; this is only the API URL.
VITE_API_BASE_URL=http://localhost:8787

# -----------------------------
# AI API server
# -----------------------------
# Get this from https://aistudio.google.com/apikey
# Keep this value server-side. Do not rename it to VITE_GEMINI_API_KEY.
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.5-flash
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------
# PostgreSQL server
# -----------------------------
# Used by db:health and db:migrate and must remain server-side.
DATABASE_URL=postgresql://postgres:password@localhost:5432/dairyhub
